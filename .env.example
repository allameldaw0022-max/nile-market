# Copy to .env.local and fill in real values there. Never commit real
# secrets -- this file only documents which variable names the app expects.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- never expose to the browser (no NEXT_PUBLIC_
# prefix, never import from a client component). Used only by trusted
# server-side code (e.g. admin actions, webhooks).
SUPABASE_SERVICE_ROLE_KEY=
