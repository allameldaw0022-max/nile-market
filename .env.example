# انسخ إلى .env.local واملأ القيم هناك.
# ❌ لا تضع أي قيمة حقيقية في هذا الملف ولا في المستودع.

# ── عامة (آمنة في المتصفح) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=nilemarket.online

# ── خادمية فقط — لا تصل المتصفح إطلاقًا ────────────────────────────
# يتجاوز RLS. يُستخدم في cron وwebhooks ومهام النظام فقط.
# (ملاحظة: تجاوز RLS لا يتجاوز قيود CHECK ولا triggers.)
SUPABASE_SERVICE_ROLE_KEY=

# حماية /api/v1/cron/*
CRON_SECRET=

# مزوّد البريد المعتمد (D24)
RESEND_API_KEY=
EMAIL_FROM=

# إدارة الدومينات عبر HostingProvider المعزول (D21)
HOSTING_PROVIDER_TOKEN=
HOSTING_PROJECT_ID=
