# ═══════════════════════════════════════════════════════════════════
# أسماء المتغيّرات فقط — بلا قيم. القيم تُضاف بأمر
#   supabase secrets set KEY=...
# ولا تُكتب في أي ملفّ يصل GitHub. (`.env*` محجوب في .gitignore)
# ═══════════════════════════════════════════════════════════════════

# ── نماذج الذكاء الاصطناعي ──
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ── تلغرام ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── أسرار استدعاء الدوالّ الطرفية ──
SUPPORT_WEBHOOK_SECRET=
SUPPORT_INGEST_SECRET=

# ── إعدادات السلوك ──
SITE_NAME=
# draft (الافتراضي) | auto
AI_MODE=
# عتبة الثقة في وضع auto، مثال: 0.75
AI_MIN_CONFIDENCE=
# عتبة التشابه لقبول مقطع من قاعدة المعرفة.
# ★★★ مقيسة لا مُقدَّرة (المرحلة ٣، على الإنتاج):
#   · أسئلة لا علاقة لها بالمنصّة («كيف أطبخ الملوخية؟»، «سعر الدولار»،
#     «مباراة الهلال») سقفها 0.6324.
#   · أقلّ درجةٍ لمقطعٍ **صحيح** في خمس شكاوى تجّار حقيقية: 0.6796.
# فـ0.65 يفصل بينهما — لكن بهامشٍ ضيّق (0.047). ومعناه أنّ هذه العتبة
# كاشفةُ «لا يوجد شيء ذو صلة» لا حاكمةُ صحّة؛ الحكم على الصحّة بتمرير
# عدّة مقاطع للنموذج وأمره بالتحويل إن لم تحمل جوابًا، وبـAI_MODE=draft.
AI_MIN_SIMILARITY=

# ── مزوّد النموذج (طبقة قابلة للتبديل) ──
# deepseek | openai | أي مزوّد متوافق مع OpenAI
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
# gemini
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
